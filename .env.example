# Centralized Skills .env file
# Copy this to .env and fill in your keys. Never commit the real .env file.

# Google GenAI API Key (used by mengu-image-gen, publication-designer visual critique, etc.)
GEMINI_API_KEY=

# Publication Designer Models
# Preferred fast model for independent visual review. GEMINI_FAST_MODEL is also accepted.
GEMINI_MODEL_FAST=gemini-2.5-flash

# Optional defaults for other Gemini workflows.
GEMINI_MODEL=
GEMINI_MODEL_SMART=
